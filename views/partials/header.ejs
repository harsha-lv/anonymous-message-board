<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Clubhouse</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo">Clubhouse</a>
      <nav class="nav-links">
        <a href="/" class="nav-link">Messages</a>
        <% if (locals.currentUser) { %>
          <a href="/new-message" class="nav-link">New Post</a>
          <% if (currentUser.membership_status === 'non_member') { %>
            <a href="/join-club" class="nav-link">Join Club</a>
          <% } %>
          <% if (!currentUser.is_admin) { %>
            <a href="/admin" class="nav-link">Admin</a>
          <% } %>
          <span class="nav-user">
            <%= currentUser.username %>
            <span class="nav-role">(<%= currentUser.is_admin ? 'admin' : (currentUser.membership_status === 'member' ? 'member' : 'non-member') %>)</span>
          </span>
          <a href="/logout" class="nav-link">Log Out</a>
        <% } else { %>
          <a href="/login" class="nav-link">Log In</a>
          <a href="/sign-up" class="nav-link">Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="main-content container">
    <% if (locals.successMessages && successMessages.length > 0) { %>
      <div class="alert alert-success" role="alert">
        <% successMessages.forEach(function(msg) { %>
          <div><%= msg %></div>
        <% }); %>
      </div>
    <% } %>
    <% if (locals.errorMessages && errorMessages.length > 0) { %>
      <div class="alert alert-danger" role="alert">
        <% errorMessages.forEach(function(msg) { %>
          <div><%= msg %></div>
        <% }); %>
      </div>
    <% } %>
