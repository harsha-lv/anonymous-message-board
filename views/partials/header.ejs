<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Anonymous Message Board</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo">
        <span class="logo-icon">🔒</span>
        <span class="logo-text">Clubhouse</span>
      </a>
      <nav class="nav-links">
        <% if (locals.currentUser) { %>
          <span class="nav-greeting">Hi, <%= currentUser.full_name %> (<%= currentUser.membership_status %>)</span>
          <a href="/logout" class="nav-btn btn-secondary">Log Out</a>
        <% } else { %>
          <a href="/login" class="nav-link">Log In</a>
          <a href="/sign-up" class="nav-btn btn-primary">Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="main-content container">

