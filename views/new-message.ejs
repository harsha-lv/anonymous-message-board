<%- include('partials/header', { title: 'New Post' }) %>

<div class="form-card">
  <h2>New Message</h2>
  <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
    Post a message to the board.
  </p>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert alert-danger" role="alert">
      <strong>Please fix the following:</strong>
      <ul class="error-list">
        <% errors.forEach(function(error) { %>
          <li><%= error.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/new-message" method="POST" novalidate>
    <div class="form-group">
      <label for="title">Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
        required
        autofocus
      >
    </div>

    <div class="form-group">
      <label for="text">Message</label>
      <textarea
        id="text"
        name="text"
        rows="5"
        required
      ><%= typeof formData !== 'undefined' && formData.text ? formData.text : '' %></textarea>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Publish</button>
  </form>

  <div class="form-footer">
    <a href="/">Cancel</a>
  </div>
</div>

<%- include('partials/footer') %>
