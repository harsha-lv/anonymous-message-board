<%- include('partials/header', { title: 'Messages' }) %>

<section class="page-intro">
  <% if (locals.currentUser) { %>
    <% const isMemberUser = currentUser.is_admin || currentUser.membership_status === 'member' || currentUser.membership_status === 'admin'; %>
    <h1>Welcome, <%= currentUser.full_name %></h1>
    <p>
      <% if (currentUser.is_admin) { %>
        Administrator privileges active. You can post, view authors and dates, and delete messages.
      <% } else if (isMemberUser) { %>
        Member privileges active. You can post messages and view authors and dates.
      <% } else { %>
        You can read messages. Become a member to post messages and view authors and dates.
      <% } %>
    </p>
    <div class="intro-actions">
      <% if (isMemberUser) { %>
        <a href="/new-message" class="btn btn-primary">New Post</a>
      <% } else { %>
        <a href="/membership" class="btn btn-primary">Become a Member</a>
      <% } %>
      <% if (!currentUser.is_admin) { %>
        <a href="/admin" class="btn btn-secondary">Admin Access</a>
      <% } %>
    </div>
  <% } else { %>
    <h1>Anonymous Message Board</h1>
    <p>Read messages anonymously. Members can post messages and see authors and timestamps.</p>
    <div class="intro-actions">
      <a href="/login" class="btn btn-primary">Log In</a>
      <a href="/sign-up" class="btn btn-secondary">Sign Up</a>
    </div>
  <% } %>
</section>

<section class="feed-section">
  <div class="feed-header">
    <h2>Messages</h2>
    <span class="feed-count"><%= messages.length %> <%= messages.length === 1 ? 'post' : 'posts' %></span>
  </div>

  <% 
    const canSeeAuthor = locals.currentUser && (
      locals.currentUser.membership_status === 'member' || 
      locals.currentUser.membership_status === 'admin' || 
      locals.currentUser.is_admin
    );

    const isUserAdmin = locals.currentUser && (
      locals.currentUser.is_admin || 
      locals.currentUser.membership_status === 'admin'
    );
  %>

  <% if (messages.length === 0) { %>
    <div class="empty-feed">
      <p>No messages yet.</p>
    </div>
  <% } else { %>
    <div class="message-list">
      <% messages.forEach(function(msg) { %>
        <article class="message-card">
          <h3 class="message-title"><%= msg.title %></h3>
          <p class="message-content"><%= msg.text %></p>

          <div class="message-meta-bar">
            <div class="meta-details">
              <% if (canSeeAuthor) { %>
                <span class="meta-author"><%= msg.full_name || msg.username %></span>
                <span class="meta-handle">(@<%= msg.username %>)</span>
                <span>&middot;</span>
                <time datetime="<%= msg.timestamp %>">
                  <%= new Date(msg.timestamp).toLocaleDateString(undefined, { 
                    month: 'short', 
                    day: 'numeric', 
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  }) %>
                </time>
              <% } else { %>
                <span class="meta-hidden">
                  Author and date hidden &middot;
                  <a href="<%= locals.currentUser ? '/membership' : '/login' %>">
                    <%= locals.currentUser ? 'Become a member to reveal' : 'Log in to view' %>
                  </a>
                </span>
              <% } %>
            </div>

            <% if (isUserAdmin) { %>
              <div class="meta-actions">
                <form action="/messages/<%= msg.id %>/delete" method="POST" onsubmit="return confirm('Delete this post?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
