<%- include('partials/header', { title: 'Join Club' }) %>

<div class="form-card">
  <h2>Join Club</h2>
  <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
    Enter the club secret passcode to view message authors and timestamps.
  </p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert">
      <%= error %>
    </div>
  <% } %>

  <form action="/join-club" method="POST">
    <div class="form-group">
      <label for="passcode">Club Passcode</label>
      <input
        type="password"
        id="passcode"
        name="passcode"
        required
        autofocus
      >
    </div>

    <button type="submit" class="btn btn-primary btn-block">Submit</button>
  </form>

  <div class="form-footer">
    <a href="/">Back to Messages</a>
  </div>
</div>

<%- include('partials/footer') %>
