PORT=3000

# Optional: full database connection string. Takes precedence over PG* below.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=anonymous_message_board

SESSION_SECRET=your_session_secret_key

# Trusted reverse-proxy hops: defaults to 1 in production, 0 in development.
# Use 0 for direct HTTPS; adjust to your host's actual proxy topology.
# The trusted proxy must overwrite client-supplied X-Forwarded-* headers.
# TRUST_PROXY=1

# Passcodes
MEMBER_PASSCODE=member123
ADMIN_PASSCODE=admin123
